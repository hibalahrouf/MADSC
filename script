Clear-Host
Import-Module ActiveDirectory -ErrorAction Stop
Import-Module GroupPolicy -ErrorAction Stop
$dom = Get-ADDomain; $root = $dom.DistinguishedName
"HOTE : $env:COMPUTERNAME   DOMAINE : $($dom.DNSRoot)   $(Get-Date -Format 'dd/MM/yyyy HH:mm')"
"-" * 74
$v = (Get-ItemProperty 'HKLM:\SYSTEM\CurrentControlSet\Services\NTDS\Parameters' `
        -Name LDAPServerIntegrity).LDAPServerIntegrity
"[1] LDAPServerIntegrity (valeur effective) ....... $v`n"
"[2] Ordre des strategies liees a OU=Domain Controllers"
(Get-GPInheritance -Target "OU=Domain Controllers,$root").GpoLinks |
  Sort-Object Order | ForEach-Object { "      {0}  {1}" -f $_.Order, $_.DisplayName }
"`n[3] Liaison LDAP simple en clair, port 389 (identifiants volontairement factices)"
$id = New-Object System.DirectoryServices.Protocols.LdapDirectoryIdentifier($env:COMPUTERNAME,389)
$cn = New-Object System.DirectoryServices.Protocols.LdapConnection($id)
$cn.AuthType = [System.DirectoryServices.Protocols.AuthType]::Basic
$cn.SessionOptions.ProtocolVersion = 3
$cn.Credential = New-Object System.Net.NetworkCredential('probe_inexistant','x',$dom.DNSRoot)
try   { $cn.Bind(); "      ECHEC - liaison en clair acceptee" }
catch { "      PASS  - rejetee : $($_.Exception.Message)" }
"`n[4] Controle positif - la voie signee fonctionne toujours"
$n = (Get-ADUser -Filter * -ResultSetSize 5 | Measure-Object).Count
"      Requete LDAP signee : $n objets retournes"
