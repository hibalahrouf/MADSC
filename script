Clear-Host
Import-Module ActiveDirectory -ErrorAction Stop
$dom = Get-ADDomain; $root = $dom.DistinguishedName
"HOTE : $env:COMPUTERNAME   DOMAINE : $($dom.DNSRoot)   $(Get-Date -Format 'dd/MM/yyyy HH:mm')"
"-" * 74
$maq = (Get-ADObject $root -Properties 'ms-DS-MachineAccountQuota').'ms-DS-MachineAccountQuota'
"[1] ms-DS-MachineAccountQuota ................ $maq`n"
"[2] AccountNotDelegated - comptes d'administration"
Get-ADUser -Filter "Name -eq 'Administrateur' -or Name -like 'adm_t*'" -Properties AccountNotDelegated |
  Sort-Object Name | ForEach-Object { "      {0,-20} {1}" -f $_.Name, $_.AccountNotDelegated }
"`n[3] ACE Operateurs de compte / d'impression sur les unites Tier 0"
$noms = 'S-1-5-32-548','S-1-5-32-550' | ForEach-Object {
  (New-Object System.Security.Principal.SecurityIdentifier $_).Translate([System.Security.Principal.NTAccount]).Value }
Get-ADOrganizationalUnit -SearchBase "OU=Tier0,$root" -SearchScope Subtree -Filter * |
  Sort-Object Name | ForEach-Object {
    $n = @((Get-Acl "AD:\$($_.DistinguishedName)").Access |
           Where-Object { $noms -contains $_.IdentityReference.Value }).Count
    "      {0,-20} {1} ACE" -f $_.Name, $n }
"`n[4] adminCount et heritage d'ACL"
'Hibalahrouf','adm_t1_oussama' | ForEach-Object {
  $u = Get-ADUser $_ -Properties adminCount
  $ac = if ($null -eq $u.adminCount) { '<vide>' } else { $u.adminCount }
  $h = -not (Get-Acl "AD:\$($u.DistinguishedName)").AreAccessRulesProtected
  "      {0,-20} adminCount={1,-8} HeritageActif={2}" -f $u.Name, $ac, $h }
$rb = Get-ADOptionalFeature -Filter "Name -eq 'Recycle Bin Feature'"
$etat = if ($rb.EnabledScopes.Count -gt 0) { 'Activee' } else { 'Desactivee' }
"`n[5] Corbeille Active Directory ............... $etat"
$np = @(Get-ADOrganizationalUnit -Filter * -Properties ProtectedFromAccidentalDeletion |
        Where-Object { -not $_.ProtectedFromAccidentalDeletion }).Count
"    Unites non protegees contre la suppression  $np"
